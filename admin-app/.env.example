# Desarrollo local: usa el proxy de Vite hacia http://127.0.0.1:8081
# Deploy en Vercel: usa /api/v1 para aprovechar admin-app/vercel.json y evitar CORS.
# Solo apunta directo a Railway si ese backend ya acepta tu dominio de Vercel y las credenciales existen ahi.
# VITE_API_BASE_URL=https://apitj-production.up.railway.app/api/v1
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=API_TJ Admin
VITE_SESSION_STORAGE_KEY=api_tj_admin_session
