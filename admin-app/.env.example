# Desarrollo local: usa el proxy de Vite hacia http://127.0.0.1:8081
# Deploy en Render: configura VITE_API_BASE_URL con la URL publica completa del backend.
# Para tu API actual en Railway usa:
# VITE_API_BASE_URL=https://apitj-production.up.railway.app/api/v1
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=API_TJ Admin
VITE_SESSION_STORAGE_KEY=api_tj_admin_session
